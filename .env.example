# =============================================================================
# YouTube Downloader - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to '.env' and adjust the settings to your environment:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux / macOS)
# =============================================================================

# -----------------------------------------------------------------------------
# Server Host & Port Settings
# -----------------------------------------------------------------------------
# HOST: IP address to bind the HTTP server to.
#   - 0.0.0.0 : Accessible across local network (LAN) and container bridges (default)
#   - 127.0.0.1 : Localhost only (safe for local-only machines)
HOST=0.0.0.0

# PORT: Port number for the HTTP web server and WebSockets (default: 8000)
PORT=8000

# RELOAD: Enable auto-reloading on code modifications (useful for local development)
# Options: false (production), true (development)
RELOAD=false

# -----------------------------------------------------------------------------
# Security & CORS Settings
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
#   Use * to allow all origins, or specify exact domains:
#   e.g. https://mydomain.com,http://localhost:3000
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Performance & Concurrency Controls
# -----------------------------------------------------------------------------
# MAX_CONCURRENT_DOWNLOADS: Maximum number of simultaneous supervised download processes.
#   Extra requests stay queued with live progress until a worker slot is released.
#   Recommended: 2 - 6 depending on CPU and network bandwidth (default: 4).
MAX_CONCURRENT_DOWNLOADS=4

# -----------------------------------------------------------------------------
# Storage & Auto-Clean Configuration
# -----------------------------------------------------------------------------
# DOWNLOADS_DIR_PATH: Directory path where downloaded media files are stored.
#   Default: a private process-specific OS temporary directory
# DOWNLOADS_DIR_PATH=./downloads

# CLEANUP_TTL_SECONDS: Retention duration (in seconds) for completed downloads.
#   After this duration, completed files are automatically unlinked to free disk.
#   Default: 1800 (30 minutes)
CLEANUP_TTL_SECONDS=1800

# DOWNLOAD_TIMEOUT_SECONDS: Maximum lifetime of one download process.
#   Cancelled/disconnected jobs terminate immediately and release the queue slot.
DOWNLOAD_TIMEOUT_SECONDS=1800

# MAX_DISK_STORAGE_BYTES: Storage limit for the downloads folder (in bytes).
#   When the folder exceeds this limit, the background cleaner purges the oldest
#   completed files first.
#   Default: 3221225472 (3 Gigabytes)
MAX_DISK_STORAGE_BYTES=3221225472

# -----------------------------------------------------------------------------
# YouTube Cloud & Anti-Bot Protection (Optional / Recommended for VPS)
# -----------------------------------------------------------------------------
# If deploying to a datacenter VPS (AWS, GCP, DigitalOcean, Hetzner, etc.),
# YouTube may block server IPs with HTTP 429 or "Sign in to confirm you're not a bot".
#
# YTDLP_COOKIES_PATH: Absolute or relative path to a cookies.txt file exported
#   from a valid YouTube browser session (e.g. using a browser cookies extension).
# YTDLP_COOKIES_PATH=./cookies.txt
#
# YTDLP_PROXY: HTTP/SOCKS5 proxy URL to route yt-dlp traffic through residential proxies.
#   Format: http://username:password@proxy_host:port
# YTDLP_PROXY=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# LOG_LEVEL: Application logging verbosity.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# External browser origin when using an HTTPS tunnel or reverse proxy.
# Example: PUBLIC_ORIGIN=https://ytd.example.com
PUBLIC_ORIGIN=
